# ============================================================================
# TabML Environment Variables Configuration
# ============================================================================
#
# This is an example environment file for TabML with MLflow integration.
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file to create your local .env file:
#    cp .env.example .env
#
# 2. Edit the .env file with your actual values
#
# 3. IMPORTANT: Never commit .env to version control!
#    The .env file is already in .gitignore for your safety.
#
# ============================================================================

# ------------------------------------------------------------------------------
# MLFLOW CONFIGURATION
# ------------------------------------------------------------------------------

# MLflow tracking server URI (required for MLflow tracking)
# For local server: http://localhost:5000
# For network server (Ubuntu on LAN): http://192.168.1.100:5000 or http://ml-server.local:5000
# For DagsHub: https://dagshub.com/YOUR_USERNAME/YOUR_REPO.mlflow
# For remote server: https://your-mlflow-server.com
MLFLOW_TRACKING_URI="http://localhost:5000"

# MLflow experiment name (optional, can be set in code)
MLFLOW_EXPERIMENT_NAME="tabml-experiments"

# MLflow artifact location (optional)
# For S3: s3://my-bucket/mlflow-artifacts
# For local: file:///path/to/mlflow-artifacts
# MLFLOW_ARTIFACT_URI="./mlflow-artifacts"

# MLflow backend store (optional, for server setup)
# For SQLite: sqlite:///mlflow.db
# For PostgreSQL: postgresql://user:password@localhost/mlflow
# MLFLOW_BACKEND_STORE_URI="sqlite:///mlflow.db"

# ------------------------------------------------------------------------------
# DAGSHUB CONFIGURATION (Optional - for DagsHub MLflow)
# ------------------------------------------------------------------------------

# DagsHub username (required for DagsHub MLflow)
# DAGSHUB_USERNAME="your-dagshub-username"

# DagsHub token (required for DagsHub MLflow)
# Get it from: https://dagshub.com/user/settings/tokens
# DAGSHUB_TOKEN="your-dagshub-token"

# DagsHub repo owner (if different from username)
# DAGSHUB_REPO_OWNER="repo-owner"

# DagsHub repo name
# DAGSHUB_REPO_NAME="your-repo-name"

# Note: For DagsHub, you can also set these standard MLflow env vars:
# MLFLOW_TRACKING_USERNAME="${DAGSHUB_USERNAME}"
# MLFLOW_TRACKING_PASSWORD="${DAGSHUB_TOKEN}"

# ------------------------------------------------------------------------------
# WEIGHTS & BIASES CONFIGURATION (Optional)
# ------------------------------------------------------------------------------

# W&B API key (if using Weights & Biases)
# Get it from: https://wandb.ai/authorize
# WANDB_API_KEY="your-wandb-api-key-here"

# W&B project name
# WANDB_PROJECT="tabml_experiments"

# W&B entity (username or team name)
# WANDB_ENTITY="your-username"

# ------------------------------------------------------------------------------
# EXPERIMENT CONFIGURATION (Optional)
# ------------------------------------------------------------------------------

# Default experiment tags (comma-separated)
EXPERIMENT_TAGS="tabml,dev,local"

# Default random seed for reproducibility
RANDOM_SEED=42

# Enable/disable GPU usage
USE_GPU=true

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# DATA PATHS (Optional)
# ------------------------------------------------------------------------------

# Path to your data directory
DATA_DIR="./data"

# Path to save model outputs
OUTPUT_DIR="./output"

# Path to save experiment logs
LOG_DIR="./logs"

# ------------------------------------------------------------------------------
# MODEL REGISTRY (Optional)
# ------------------------------------------------------------------------------

# Model staging environment
# Options: development, staging, production
MODEL_STAGE="development"

# Auto-register best models
AUTO_REGISTER_MODELS=true

# Minimum metric threshold for model registration
MIN_METRIC_THRESHOLD=0.85

# ============================================================================
# USAGE IN PYTHON:
# ============================================================================
#
# from dotenv import load_dotenv
# import os
#
# # Load environment variables
# load_dotenv()
#
# # Use with TabML
# from tabml import MLflowTracker
#
# tracker = MLflowTracker(
#     experiment_name=os.getenv("MLFLOW_EXPERIMENT_NAME"),
#     tracking_uri=os.getenv("MLFLOW_TRACKING_URI"),
#     tags={"env": "dev", "framework": "tabml"}
# )
#
# ============================================================================
# SECURITY NOTES:
# ============================================================================
#
# 1. NEVER commit .env files with real credentials
# 2. Keep .env in .gitignore (already configured)
# 3. Use different tokens for development and production
# 4. Rotate API tokens regularly
# 5. Use read-only tokens when possible for deployment
#
# ============================================================================